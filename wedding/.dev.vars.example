# Copy to .dev.vars for `npm run preview`. These are Cloudflare's published
# Turnstile TEST keys: they always pass and only work for local development.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Lets /admin skip the Cloudflare Access check, but only on localhost.
ADMIN_DEV_BYPASS=true
